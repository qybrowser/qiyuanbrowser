{
  "manifest_version": 3,
  "name": "Qiyuan MS",
  "version": "1.3.1",
  "key": "",
  "description": "Manages Manager System",
  "permissions": [
    "cookies",
    "storage",
    "qiyuan",
    "localhost",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/16x16.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/16x16.png",
      "48": "icons/48x48.png",
      "128": "icons/128x128.png"
    }
  },
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["pages/*.html", "pages/*.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_scripts/injector.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
